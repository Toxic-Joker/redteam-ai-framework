# Copier en .env avant `docker compose up --build`.
# Une seule source de verite par variable : core/config.py (CLAUDE.md, section 9).

# Point d'acces au conteneur Ollama. Ne pas changer sauf profil host-ollama
# (docker-compose.host-ollama.yml gere ce cas separement).
OLLAMA_BASE_URL=http://ollama:11434

# Modele principal utilise par tous les agents (aucun changement de code
# necessaire, juste cette variable). RAM approximative a l'inference :
#   qwen3.5:9b (defaut)  ~7-8 Go RAM  -> reserver aux machines avec 12+ Go
#   qwen3.5:4b           ~4-4.5 Go RAM -> recommande sur une machine a ~8 Go
#   qwen3:8b             ~6-7 Go RAM  -> repli si qwen3.5 pose un souci de gabarit de chat
# Voir CLAUDE.md section 3 pour le tableau complet et docs/HISTORY.md section 6
# pour le retour d'un deploiement reel sur une machine a 8 Go de RAM.
OLLAMA_MODEL_MAIN=qwen3.5:9b

# Modele d'embeddings pour la memoire semantique ChromaDB (leger, sans torch).
OLLAMA_EMBED_MODEL=nomic-embed-text

# Bloque toute mission sans reference d'autorisation quand true.
REQUIRE_AUTHORIZATION=true

# CIDR separes par des virgules (ex. "10.0.0.0/8,192.168.0.0/16"). Vide par
# defaut = aucune restriction (le MVP doit fonctionner contre une cible
# externe quelconque). A activer pour verrouiller ses propres missions a un
# laboratoire connu et eviter de scanner sa propre machine par erreur.
ALLOWED_TARGET_RANGES=

# "syn" (-sS, defaut si root) ou "connect" (-sT, repli reseaux filtres/non-root).
NMAP_SCAN_MODE=syn

# Garde-fou anti-boucle de l'orchestrateur.
MAX_CYCLES=10

LOG_LEVEL=INFO

# Copier en .env avant `docker compose up --build`.
# Une seule source de verite par variable : core/config.py (CLAUDE.md, section 9).

# Point d'acces au conteneur Ollama. Ne pas changer sauf profil host-ollama
# (docker-compose.host-ollama.yml gere ce cas separement).
OLLAMA_BASE_URL=http://ollama:11434

# Modele principal utilise par tous les agents. Repli eprouve : qwen3:8b
# (aucun changement de code necessaire, juste cette variable).
OLLAMA_MODEL_MAIN=qwen3.5:9b

# Modele d'embeddings pour la memoire semantique ChromaDB (leger, sans torch).
OLLAMA_EMBED_MODEL=nomic-embed-text

# Bloque toute mission sans reference d'autorisation quand true.
REQUIRE_AUTHORIZATION=true

# "syn" (-sS, defaut si root) ou "connect" (-sT, repli reseaux filtres/non-root).
NMAP_SCAN_MODE=syn

# Garde-fou anti-boucle de l'orchestrateur.
MAX_CYCLES=10

LOG_LEVEL=INFO
